{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小説エディタ",
  "version": "0.1.0",
  "identifier": "com.noveleditor.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "小説エディタ",
        "width": 980,
        "height": 720,
        "minWidth": 560,
        "minHeight": 400
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
